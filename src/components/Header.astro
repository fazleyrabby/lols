---
import type { LolSite } from '../types/site';
import { formatVisits, formatRank } from '../utils/format';

interface Props {
  sites?: LolSite[];
}

const { sites = [] } = Astro.props;

const sitesJson = JSON.stringify(sites.map(s => ({
  ...s,
  formattedVisits: formatVisits(s.monthlyVisits),
  formattedRank: formatRank(s.globalRank)
})));
---

<header class="border-b-2 border-black bg-white sticky top-0 z-30">
  <div class="max-w-7xl mx-auto px-4 h-14 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2 group">
      <div class="bg-black text-white px-2.5 py-0.5 font-bold font-mono text-base tracking-wider border-2 border-black shadow-[2px_2px_0px_#FFE600] group-hover:translate-x-[-1px] group-hover:translate-y-[-1px] transition-transform">
        .lol
      </div>
      <span class="font-extrabold text-sm tracking-tight text-black uppercase">Explorer</span>
    </a>

    <!-- Header Actions -->
    <div class="flex items-center gap-3 text-xs font-mono font-bold">
      <button 
        id="random-lol-btn" 
        type="button" 
        data-sites={sitesJson}
        class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#FFE600] text-black border-2 border-black shadow-[2px_2px_0px_#000] hover:shadow-[3px_3px_0px_#000] hover:translate-x-[-1px] hover:translate-y-[-1px] active:translate-x-[1px] active:translate-y-[1px] active:shadow-none transition-all cursor-pointer"
        title="Discover a random .lol site"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"><path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/></svg>
        <span>RANDOM .LOL</span>
      </button>

      <a 
        href="https://github.com" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="hidden sm:inline-flex items-center px-3 py-1.5 bg-white text-black border-2 border-black shadow-[2px_2px_0px_#000] hover:bg-neutral-100 hover:translate-x-[-1px] hover:translate-y-[-1px] transition-all"
      >
        Submit Site
      </a>
    </div>
  </div>
</header>

<script>
  const randomBtn = document.getElementById('random-lol-btn');
  if (randomBtn) {
    randomBtn.addEventListener('click', () => {
      try {
        const sites = JSON.parse(randomBtn.getAttribute('data-sites') || '[]');
        if (sites.length > 0) {
          const randomSite = sites[Math.floor(Math.random() * sites.length)];
          (window as any).openSiteModal?.(randomSite);
        }
      } catch (err) {
        console.error(err);
      }
    });
  }
</script>
