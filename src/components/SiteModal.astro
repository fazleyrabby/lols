---
---
<dialog id="site-modal" class="backdrop:bg-black/60 p-0 bg-transparent rounded-none max-w-lg w-full m-auto open:animate-in open:fade-in border-0 focus:outline-none">
  <div class="bg-[#FFFDF5] border-3 border-black text-black shadow-[8px_8px_0px_#000] p-6 relative mx-4 sm:mx-0">
    <!-- Close Button -->
    <button id="modal-close-btn" class="absolute top-4 right-4 p-1 text-black bg-white border-2 border-black shadow-[2px_2px_0px_#000] hover:bg-[#FFE600] active:translate-x-[1px] active:translate-y-[1px] active:shadow-none transition-all cursor-pointer" aria-label="Close modal">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>

    <!-- Header / Domain -->
    <div class="mb-4 pr-10">
      <div class="flex items-center gap-2 mb-1">
        <span class="w-2.5 h-2.5 rounded-full bg-[#FFE600] border border-black"></span>
        <span id="modal-domain" class="font-mono font-black text-xl tracking-tight text-black"></span>
      </div>
      <h3 id="modal-title" class="text-xl font-black text-black"></h3>
    </div>

    <!-- Description -->
    <p id="modal-description" class="text-xs sm:text-sm font-medium text-neutral-700 mb-6 leading-relaxed"></p>

    <!-- Metrics Grid -->
    <div class="grid grid-cols-2 gap-3 p-3.5 bg-white border-2 border-black shadow-[3px_3px_0px_#000] mb-6 text-xs font-mono">
      <div>
        <span class="text-neutral-500 block uppercase tracking-wider text-[10px] font-bold">Category</span>
        <span id="modal-category" class="font-black text-black text-sm"></span>
      </div>
      <div>
        <span class="text-neutral-500 block uppercase tracking-wider text-[10px] font-bold">Est. Monthly Visits</span>
        <span id="modal-visits" class="font-black text-black text-sm"></span>
      </div>
      <div>
        <span class="text-neutral-500 block uppercase tracking-wider text-[10px] font-bold">Global Rank</span>
        <span id="modal-rank" class="font-bold text-neutral-800 text-sm"></span>
      </div>
      <div>
        <span class="text-neutral-500 block uppercase tracking-wider text-[10px] font-bold">Data Source</span>
        <span id="modal-source" class="text-neutral-700 text-xs font-medium"></span>
      </div>
    </div>

    <!-- Detected Technologies -->
    <div class="mb-5">
      <span class="text-neutral-500 block uppercase tracking-wider text-[10px] font-mono font-bold mb-2">Detected Technologies</span>
      <div id="modal-technologies" class="flex flex-wrap gap-1.5"></div>
    </div>

    <!-- Tags -->
    <div class="mb-6">
      <span class="text-neutral-500 block uppercase tracking-wider text-[10px] font-mono font-bold mb-2">Tags</span>
      <div id="modal-tags" class="flex flex-wrap gap-1.5"></div>
    </div>

    <!-- Action Button -->
    <div class="pt-4 border-t-2 border-black flex items-center justify-between">
      <span class="text-[11px] text-neutral-500 font-mono font-bold" id="modal-checked"></span>
      <a id="modal-visit-btn" href="#" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-4 py-2 bg-[#FFE600] text-black border-2 border-black font-mono font-bold text-xs shadow-[3px_3px_0px_#000] hover:shadow-[5px_5px_0px_#000] hover:translate-x-[-1px] hover:translate-y-[-1px] active:translate-x-[1px] active:translate-y-[1px] active:shadow-none transition-all">
        <span>VISIT WEBSITE</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
      </a>
    </div>
  </div>
</dialog>

<script>
  const modal = document.getElementById('site-modal') as HTMLDialogElement;
  const closeBtn = document.getElementById('modal-close-btn');

  closeBtn?.addEventListener('click', () => modal?.close());
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) modal.close();
  });

  (window as any).openSiteModal = function(siteData: any) {
    if (!modal) return;
    
    document.getElementById('modal-domain')!.textContent = siteData.domain;
    document.getElementById('modal-title')!.textContent = siteData.title;
    document.getElementById('modal-description')!.textContent = siteData.description;
    document.getElementById('modal-category')!.textContent = siteData.category;
    document.getElementById('modal-visits')!.textContent = siteData.formattedVisits;
    document.getElementById('modal-rank')!.textContent = siteData.formattedRank;
    document.getElementById('modal-source')!.textContent = siteData.source ? `${siteData.source} (Estimate)` : 'Estimate unavailable';
    document.getElementById('modal-checked')!.textContent = siteData.lastChecked ? `Verified: ${siteData.lastChecked}` : '';
    
    const visitBtn = document.getElementById('modal-visit-btn') as HTMLAnchorElement;
    visitBtn.href = `https://${siteData.domain}`;

    const techContainer = document.getElementById('modal-technologies')!;
    techContainer.innerHTML = '';
    (siteData.technologies || []).forEach((tech: string) => {
      const span = document.createElement('span');
      span.className = 'px-2 py-0.5 bg-white text-black text-xs font-mono font-bold border border-black shadow-[1px_1px_0px_#000]';
      span.textContent = tech;
      techContainer.appendChild(span);
    });

    const tagsContainer = document.getElementById('modal-tags')!;
    tagsContainer.innerHTML = '';
    (siteData.tags || []).forEach((tag: string) => {
      const span = document.createElement('span');
      span.className = 'px-2 py-0.5 bg-[#F6F6F6] text-neutral-800 text-[11px] font-mono border border-black';
      span.textContent = `#${tag}`;
      tagsContainer.appendChild(span);
    });

    modal.showModal();
  };
</script>
