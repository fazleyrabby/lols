---
import type { LolSite } from '../types/site';
import { formatVisits, formatRank } from '../utils/format';

interface Props {
  sites: LolSite[];
}

const { sites } = Astro.props;

// Sort by monthly visits descending and pick top 4
const trending = [...sites]
  .sort((a, b) => (b.monthlyVisits || 0) - (a.monthlyVisits || 0))
  .slice(0, 4);

const [site1, site2, site3, site4] = trending;

function getSiteJson(site: LolSite) {
  return JSON.stringify({
    ...site,
    formattedVisits: formatVisits(site.monthlyVisits),
    formattedRank: formatRank(site.globalRank)
  });
}
---

<section class="max-w-7xl mx-auto px-4 pt-8 pb-4">
  <div class="flex items-center justify-between mb-4 pb-2 border-b-2 border-black">
    <div class="flex items-center gap-2">
      <span class="bg-black text-white px-2 py-0.5 font-mono text-[10px] font-bold uppercase">TRENDING</span>
      <h2 class="text-base font-extrabold text-black uppercase tracking-tight">Spotlight .lol Sites</h2>
    </div>
    <span class="text-xs text-neutral-600 font-mono font-medium">Ranked by traffic velocity</span>
  </div>

  <!-- Neo-Brutalist Bento Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
    
    <!-- Bento Tile 1: #1 Spotlight (Spans 2 cols & 2 rows on desktop) -->
    {site1 && (
      <article 
        class="group lg:col-span-2 lg:row-span-2 bg-[#FFFDF5] border-2 border-black shadow-[4px_4px_0px_#000] hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-[7px_7px_0px_#000] transition-all p-6 flex flex-col justify-between cursor-pointer relative"
        data-site-json={getSiteJson(site1)}
        onclick="window.openSiteModal(JSON.parse(this.dataset.siteJson))"
      >
        <!-- Mock Browser Bar -->
        <div>
          <div class="flex items-center justify-between gap-2 pb-3 mb-4 border-b-2 border-black">
            <div class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-full bg-[#FB923C] border border-black"></span>
              <span class="w-3 h-3 rounded-full bg-[#FFE600] border border-black"></span>
              <span class="w-3 h-3 rounded-full bg-[#A3E635] border border-black"></span>
              <span class="ml-2 font-mono text-xs font-bold text-black truncate">https://{site1.domain}</span>
            </div>
            <span class="px-2.5 py-0.5 bg-[#FFE600] text-black border border-black text-[10px] font-mono font-black uppercase shadow-[1px_1px_0px_#000]">
              #1 SPOTLIGHT
            </span>
          </div>

          <div class="flex items-center gap-2 mb-3">
            <span class="px-2 py-0.5 bg-[#38BDF8] text-black text-xs font-mono font-bold border border-black shadow-[1px_1px_0px_#000]">
              {site1.category}
            </span>
            <span class="font-mono text-xs font-bold text-neutral-600">{formatRank(site1.globalRank)}</span>
          </div>

          <h3 class="text-2xl sm:text-3xl font-extrabold text-black mb-3 group-hover:underline underline-offset-4 decoration-2">
            {site1.title}
          </h3>

          <p class="text-xs sm:text-sm font-medium text-neutral-700 leading-relaxed mb-6">
            {site1.description}
          </p>
        </div>

        <!-- Tile 1 Footer -->
        <div class="pt-4 border-t-2 border-black flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <div>
            <span class="text-neutral-500 text-[10px] font-mono font-bold uppercase block">EST. MONTHLY TRAFFIC</span>
            <div class="text-3xl font-black font-mono text-black tracking-tight">
              {formatVisits(site1.monthlyVisits)} <span class="text-xs font-bold text-neutral-500">visits</span>
            </div>
          </div>

          <div class="flex flex-wrap gap-1.5">
            {site1.technologies.map((tech) => (
              <span class="px-2 py-0.5 bg-white text-black text-xs font-mono font-bold border border-black shadow-[1px_1px_0px_#000]">
                {tech}
              </span>
            ))}
          </div>
        </div>
      </article>
    )}

    <!-- Bento Tile 2: #2 Spotlight (Spans 2 cols on lg) -->
    {site2 && (
      <article 
        class="group lg:col-span-2 bg-white border-2 border-black shadow-[3px_3px_0px_#000] hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-[6px_6px_0px_#000] transition-all p-5 flex flex-col justify-between cursor-pointer"
        data-site-json={getSiteJson(site2)}
        onclick="window.openSiteModal(JSON.parse(this.dataset.siteJson))"
      >
        <div>
          <div class="flex items-center justify-between mb-2.5">
            <div class="flex items-center gap-2">
              <span class="font-mono text-xs font-black px-2 py-0.5 bg-[#A3E635] text-black border border-black shadow-[1px_1px_0px_#000]">#2</span>
              <span class="font-mono font-bold text-sm text-black">{site2.domain}</span>
            </div>
            <span class="px-2 py-0.5 bg-[#F472B6] text-black text-[11px] font-mono font-bold border border-black shadow-[1px_1px_0px_#000]">
              {site2.category}
            </span>
          </div>

          <h3 class="text-base sm:text-lg font-extrabold text-black group-hover:underline underline-offset-4 decoration-2 mb-1.5">
            {site2.title}
          </h3>
          <p class="text-xs font-medium text-neutral-700 line-clamp-2 mb-3">
            {site2.description}
          </p>
        </div>

        <div class="pt-3 border-t-2 border-black flex items-center justify-between text-xs">
          <span class="font-mono text-xs font-bold text-neutral-700">
            Est. Visits: <strong class="text-black font-black">{formatVisits(site2.monthlyVisits)}</strong>
          </span>
          <div class="flex items-center gap-1.5 text-xs font-mono font-bold text-neutral-600">
            {site2.technologies.slice(0, 3).join(' · ')}
          </div>
        </div>
      </article>
    )}

    <!-- Bento Tile 3: #3 Spotlight (1 col) -->
    {site3 && (
      <article 
        class="group lg:col-span-1 bg-white border-2 border-black shadow-[3px_3px_0px_#000] hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-[5px_5px_0px_#000] transition-all p-4 flex flex-col justify-between cursor-pointer"
        data-site-json={getSiteJson(site3)}
        onclick="window.openSiteModal(JSON.parse(this.dataset.siteJson))"
      >
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="font-mono text-xs font-black px-1.5 py-0.5 bg-[#FB923C] text-black border border-black shadow-[1px_1px_0px_#000]">#3</span>
            <span class="text-[11px] font-mono font-bold text-neutral-600">{site3.category}</span>
          </div>
          <h3 class="text-sm font-extrabold text-black group-hover:underline mb-1 truncate">
            {site3.domain}
          </h3>
          <p class="text-xs font-medium text-neutral-600 line-clamp-2 mb-3">
            {site3.description}
          </p>
        </div>

        <div class="pt-2.5 border-t-2 border-black flex items-center justify-between text-xs font-mono font-bold">
          <span class="text-neutral-500 text-[10px]">VISITS</span>
          <strong class="text-black font-black">{formatVisits(site3.monthlyVisits)}</strong>
        </div>
      </article>
    )}

    <!-- Bento Tile 4: #4 Spotlight (1 col) -->
    {site4 && (
      <article 
        class="group lg:col-span-1 bg-white border-2 border-black shadow-[3px_3px_0px_#000] hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-[5px_5px_0px_#000] transition-all p-4 flex flex-col justify-between cursor-pointer"
        data-site-json={getSiteJson(site4)}
        onclick="window.openSiteModal(JSON.parse(this.dataset.siteJson))"
      >
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="font-mono text-xs font-black px-1.5 py-0.5 bg-[#C084FC] text-black border border-black shadow-[1px_1px_0px_#000]">#4</span>
            <span class="text-[11px] font-mono font-bold text-neutral-600">{site4.category}</span>
          </div>
          <h3 class="text-sm font-extrabold text-black group-hover:underline mb-1 truncate">
            {site4.domain}
          </h3>
          <p class="text-xs font-medium text-neutral-600 line-clamp-2 mb-3">
            {site4.description}
          </p>
        </div>

        <div class="pt-2.5 border-t-2 border-black flex items-center justify-between text-xs font-mono font-bold">
          <span class="text-neutral-500 text-[10px]">VISITS</span>
          <strong class="text-black font-black">{formatVisits(site4.monthlyVisits)}</strong>
        </div>
      </article>
    )}

  </div>
</section>
