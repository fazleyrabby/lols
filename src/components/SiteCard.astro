---
import type { LolSite } from '../types/site';
import { formatVisits, formatRank } from '../utils/format';

interface Props {
  site: LolSite;
}

const { site } = Astro.props;
const formattedVisits = formatVisits(site.monthlyVisits);
const formattedRank = formatRank(site.globalRank);

const siteJson = JSON.stringify({
  ...site,
  formattedVisits,
  formattedRank
});
---

<article 
  class="site-item group bg-white border-2 border-black shadow-[3px_3px_0px_#000] hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-[6px_6px_0px_#000] transition-all p-5 flex flex-col justify-between cursor-pointer"
  data-domain={site.domain.toLowerCase()}
  data-title={site.title.toLowerCase()}
  data-description={site.description.toLowerCase()}
  data-category={site.category}
  data-tech={site.technologies.join(',')}
  data-tags={(site.tags || []).join(',')}
  data-visits={site.monthlyVisits || 0}
  data-rank={site.globalRank || 9999999}
  data-site-json={siteJson}
  onclick={`window.openSiteModal(JSON.parse(this.dataset.siteJson))`}
>
  <div>
    <!-- Top Meta Row -->
    <div class="flex items-center justify-between gap-2 mb-3">
      <div class="flex items-center gap-1.5 min-w-0">
        <span class="w-2.5 h-2.5 rounded-full bg-[#FFE600] border border-black flex-shrink-0"></span>
        <span class="font-mono font-bold text-xs text-black truncate">{site.domain}</span>
      </div>
      <span class="px-2 py-0.5 bg-[#F6F6F6] text-black text-[11px] font-mono font-bold border border-black shadow-[1px_1px_0px_#000]">
        {site.category}
      </span>
    </div>

    <!-- Title & Description -->
    <h3 class="font-extrabold text-base text-black mb-1.5 group-hover:underline underline-offset-2 leading-snug">
      {site.title}
    </h3>
    <p class="text-xs font-medium text-neutral-700 leading-relaxed line-clamp-2 mb-4">
      {site.description}
    </p>
  </div>

  <!-- Bottom Details -->
  <div class="pt-3 border-t-2 border-black flex flex-col gap-2">
    <!-- Traffic & Rank -->
    <div class="flex items-center justify-between text-xs font-mono font-bold">
      <span class="text-neutral-600 text-[11px]">
        EST. VISITS: <strong class="text-black font-black">{formattedVisits}</strong>
      </span>
      {site.globalRank && (
        <span class="text-neutral-500 text-[11px]">
          {formattedRank}
        </span>
      )}
    </div>

    <!-- Technologies Preview -->
    {site.technologies.length > 0 && (
      <div class="flex items-center gap-1 overflow-hidden text-[10px] text-neutral-600 font-mono font-bold">
        <span class="truncate">{site.technologies.slice(0, 3).join(' · ')}</span>
        {site.technologies.length > 3 && <span class="text-neutral-400">+{site.technologies.length - 3}</span>}
      </div>
    )}
  </div>
</article>
